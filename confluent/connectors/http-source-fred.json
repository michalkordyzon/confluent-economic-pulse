{
  "connector.class": "HttpSourceV2",
  "name": "economic-pulse-fred-source",
  "kafka.auth.mode": "SERVICE_ACCOUNT",
  "kafka.service.account.id": "<SERVICE_ACCOUNT_ID>",
  "output.data.format": "JSON_SR",
  "tasks.max": "1",
  "http.api.base.url": "https://api.stlouisfed.org",
  "auth.type": "API_KEY",
  "api.key.location": "QUERY",
  "api.key.name": "api_key",
  "api.key.value": "<FRED_API_KEY>",
  "apis.num": "1",
  "api1.http.api.path": "/fred/series/observations",
  "api1.http.request.method": "GET",
  "api1.http.request.parameters": "series_id=ICSA&file_type=json&sort_order=desc&limit=1",
  "api1.http.response.data.json.pointer": "/observations",
  "api1.http.offset.mode": "SNAPSHOT_PAGINATION",
  "api1.http.request.interval.ms": "604800000",
  "api1.topics": "raw.fred.icsa",
  "behavior.on.error": "FAIL"
}
